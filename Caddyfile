# Caddyfile for QuizzQuizz
# Serves static files directly and proxies API requests to Node.js

{
    # Disable automatic HTTPS for local development
    auto_https off
    # Admin API disabled for simplicity
    admin off
}

# Listen on port 80
:80 {
    # Enable compression
    encode gzip

    # API routes - proxy to Node.js API server
    # Match both /api and /api/*
    handle /api* {
        reverse_proxy quizzquizz:3000
    }

    # Health check endpoint - proxy to Node.js API server
    handle /health {
        reverse_proxy quizzquizz:3000
    }

    # Host app - serve static files directly from filesystem
    handle /host* {
        root * /app/packages/host-app/dist
        uri strip_prefix /host
        try_files {path} /index.html
        file_server
    }

    # Player app - serve static files directly from filesystem (root and all other routes)
    handle /* {
        root * /app/packages/player-app/dist
        try_files {path} /index.html
        file_server
    }

    # Logging
    log {
        output stdout
        format console
    }
}
