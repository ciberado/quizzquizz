# Tailscale Configuration
# Generate an auth key at: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Tailnet domain (e.g., tail1234.ts.net)
# Used for CORS configuration to allow requests from your Tailscale hostname
TAILNET_DOMAIN=tail1234.ts.net

# Public HTTPS deployment (e.g., https://quizzquizzdev.aprender.cloud)
# Required when deploying behind a reverse proxy with a public domain
BETTER_AUTH_BASE_URL=https://your-domain.example.com
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=https://your-domain.example.com
PRODUCTION_HTTPS=true

# Global Admin Account (bootstrapped on server startup)
# If ADMIN_EMAIL is set, an admin user is created on startup if no admin exists yet.
# If ADMIN_PASSWORD is omitted, a random password is auto-generated and logged to stdout.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# IMAP Authentication (optional)
# When IMAP_HOST is set, users can sign in using their IMAP email credentials.
# The server validates the credentials against the IMAP server — no password is stored locally.
IMAP_HOST=
IMAP_PORT=993
IMAP_TLS=true
