{
  "name": "@quizzquizz/root",
  "version": "0.0.0",
  "private": true,
  "description": "QuizzQuizz - Real-time competitive quiz platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/javi-moreno/quizzquizz.git"
  },
  "author": "Javi Moreno <email@javier-moreno.com>",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "bash -c 'source /usr/local/share/nvm/nvm.sh && nvm use 22 && playwright test'",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
