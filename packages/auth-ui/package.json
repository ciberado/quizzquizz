{
  "name": "@quizzquizz/auth-ui",
  "version": "0.17.5",
  "description": "Shared authentication UI components for QuizzQuizz apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --config vitest.config.ts",
    "test:run": "vitest --run"
  },
  "devDependencies": {
    "happy-dom": "^20.8.3",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
