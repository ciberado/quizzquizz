// Prisma schema for QuizzQuizz
// Migrated from Drizzle ORM + better-sqlite3

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Authentication Tables (Better Auth)
// ============================================================================

model User {
  id            String    @id
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  username      String    @unique
  name          String?
  image         String?   // Avatar URL
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  // Relations
  accounts           Account[]
  sessions           Session[]
  hostedSessions     HostedSession[]
  playerStats        PlayerStat[]
  savedQuizzes       SavedQuiz[]
  quizSessions       QuizSession[]
  userQuestionStats  UserQuestionStat[]
  
  @@map("users")
}

model Account {
  id                String    @id
  userId            String    @map("user_id")
  accountId         String    @map("account_id") // Provider-specific account ID
  providerId        String    @map("provider_id") // "credential" | "google" | "github"
  password          String?   // Hashed password for credential accounts
  accessToken       String?   @map("access_token")
  refreshToken      String?   @map("refresh_token")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope             String?
  idToken           String?   @map("id_token")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("accounts")
}

model Session {
  id           String   @id
  token        String   @unique // Auth session token
  userId       String   @map("user_id")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

model Verification {
  id         String   @id
  identifier String   // email or user ID
  value      String   // the token value
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  
  @@map("verifications")
}

// ============================================================================
// Quiz Session Tables (Existing)
// ============================================================================

model QuizSession {
  id                   String    @id
  pin                  String    @unique
  hostToken            String    @map("host_token")
  userId               String?   @map("user_id") // NEW: Link to authenticated host (nullable for anonymous)
  mode                 String    @default("quiz") // 'quiz' | 'flashcard'
  questionBankId       String    @map("question_bank_id")
  questionIds          String?   @map("question_ids") // JSON array of question IDs to use (null = all questions) 
  randomOrder          Boolean   @default(false) @map("random_order") // Whether to shuffle questions
  shuffleAnswers       Boolean   @default(true) @map("shuffle_answers") // Whether to shuffle answer order within each question
  automaticPace        Boolean   @default(false) @map("automatic_pace") // Auto-advance through questions and leaderboards
  autoQuestionTime     Boolean   @default(false) @map("auto_question_time") // Calculate time limits automatically based on question complexity
  pace                 String    @default("normal") // 'normal' | 'calm' | 'manual' — controls question timing pace
  status               String    @default("lobby") // 'lobby' | 'playing' | 'finished' | 'abandoned'
  currentQuestionIndex Int       @default(-1) @map("current_question_index")
  questionStartedAt    DateTime? @map("question_started_at") // timestamp
  timeLimitOverride    Int?      @map("time_limit_override") // Host-adjusted time limit for current question (null = use computed)
  timerPausedAt        DateTime? @map("timer_paused_at") // When host paused the timer (null = running)
  createdAt            DateTime  @default(now()) @map("created_at")
  expiresAt            DateTime? @map("expires_at") // null = never expires

  // Relations
  players        Player[]
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  hostedSession  HostedSession? // Historical record when quiz completes

  @@map("quiz_sessions")
}

model Player {
  id        String   @id
  sessionId String   @map("session_id")
  userId    String?  @map("user_id") // Authenticated player's user ID (null for anonymous)
  nickname  String
  score     Int      @default(0)
  joinedAt  DateTime @default(now()) @map("joined_at")

  // Relations
  session QuizSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers PlayerAnswer[]

  @@index([userId])
  @@map("players")
}

model PlayerAnswer {
  id                String   @id
  playerId          String   @map("player_id")
  questionId        String   @map("question_id")
  selectedAnswerIds String   @map("selected_answer_ids") // JSON array as string
  isCorrect         Boolean  @map("is_correct")
  submittedAt       DateTime @map("submitted_at")
  score             Int      @default(0)
  responseTimeMs    Int      @default(0) @map("response_time_ms") // ms from question start to submission

  // Relations
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_answers")
}

// ============================================================================
// User Feature Tables (Saved Quizzes, History, Stats)
// ============================================================================

model SavedQuiz {
  id                String   @id
  userId            String   @map("user_id")
  name              String
  description       String?
  questionBankId    String   @map("question_bank_id")
  questionIds       String?  @map("question_ids") // JSON array
  randomOrder       Boolean  @default(false) @map("random_order")
  shuffleAnswers    Boolean  @default(true) @map("shuffle_answers")
  automaticPace     Boolean  @default(false) @map("automatic_pace")
  autoQuestionTime  Boolean  @default(false) @map("auto_question_time")
  isPublic          Boolean  @default(false) @map("is_public")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("saved_quizzes")
}

model HostedSession {
  id               String   @id
  userId           String   @map("user_id")
  sessionId        String   @unique @map("session_id")
  questionBankId   String   @map("question_bank_id")
  questionBankName String   @map("question_bank_name")
  totalPlayers     Int      @default(0) @map("total_players")
  totalQuestions   Int      @default(0) @map("total_questions")
  completedAt      DateTime @map("completed_at")
  
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  @@index([userId, completedAt])
  @@map("hosted_sessions")
}

model PlayerStat {
  id              String   @id
  userId          String   @map("user_id")
  sessionId       String   @map("session_id")
  nickname        String   // Nickname used in this session
  finalScore      Int      @map("final_score")
  finalRank       Int      @map("final_rank")
  correctAnswers  Int      @map("correct_answers")
  totalQuestions  Int      @map("total_questions")
  averageTime     Int      @map("average_time") // Average response time in ms
  playedAt        DateTime @map("played_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, playedAt])
  @@map("player_stats")
}

// Per-user, per-question performance across all sessions
model UserQuestionStat {
  id                String    @id
  userId            String    @map("user_id")
  questionId        String    @map("question_id")      // Stable question ID from question bank
  questionBankId    String    @map("question_bank_id") // Which bank the question belongs to
  timesAnswered     Int       @default(0) @map("times_answered")
  timesCorrect      Int       @default(0) @map("times_correct")
  averageResponseMs Int       @default(0) @map("average_response_ms")
  lastAnsweredAt    DateTime? @map("last_answered_at")
  lastWasCorrect    Boolean   @default(false) @map("last_was_correct")
  // Spaced-repetition weight: ×1.5 on wrong (min 0.1), ×0.8 on correct (max 5.0)
  // Used by future practice mode to surface questions the user consistently misses
  practiceWeight    Float     @default(1.0) @map("practice_weight")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionBankId, questionId])
  @@index([userId, questionBankId])
  @@index([userId, lastAnsweredAt])
  @@map("user_question_stats")
}

// Aggregate performance per question across ALL players (authenticated + anonymous)
model QuestionGlobalStat {
  id                  String   @id
  questionId          String   @map("question_id")
  questionBankId      String   @map("question_bank_id")
  timesAppeared       Int      @default(0) @map("times_appeared")    // Sessions that included this question
  timesAnswered       Int      @default(0) @map("times_answered")    // Actual answer submissions
  timesCorrect        Int      @default(0) @map("times_correct")
  averageResponseMs   Int      @default(0) @map("average_response_ms")
  averageScore        Int      @default(0) @map("average_score")
  // JSON map { "answerId": selectionCount } - reveals which distractors mislead players
  answerSelections    String   @default("{}") @map("answer_selections")
  // Computed from timesCorrect / timesAnswered once >= 10 answers exist
  // 0.0 = never correct, 1.0 = always correct, null = insufficient data
  empiricalDifficulty Float?   @map("empirical_difficulty")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([questionBankId, questionId])
  @@map("question_global_stats")
}
