{
  "name": "@quizzquizz/api-server",
  "version": "0.6.5",
  "description": "REST API backend for QuizzQuizz",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@hono/zod-validator": "^0.2.1",
    "@prisma/client": "^6.19.2",
    "@quizzquizz/analytics": "*",
    "@quizzquizz/common": "*",
    "@quizzquizz/question-bank": "*",
    "better-auth": "^1.4.18",
    "hono": "^4.12.5",
    "prisma": "^6.19.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
